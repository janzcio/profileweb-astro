---
//src/components/Card.astro
type WorkExperience = {
    role: string;
    company: string;
    period: string;
    description: string;
};

type Education = {
    school: string;
    location: string;
    period: string;
    logo: string;
    description: string;
};

type PortfolioItem = {
    title: string;
    image: string;
    gif: string;
    description: string;
};

const { name, position, aboutMe, linkedin, github, cvLink, profileImage, workExperience = [], education = [], portfolio = [] } = Astro.props as {
    name: string;
    position: string;
    aboutMe: string;
    linkedin: string;
    github: string;
    cvLink: string;
    profileImage: string;
    workExperience?: WorkExperience[];
    education?: Education[];
    portfolio?: PortfolioItem[];
};

import '../styles/card.css';
---

<div class="container">
    <div class="card-container" data-card>
        <button class="carousel-zone carousel-zone-previous" type="button" data-carousel-previous aria-label="Previous slide"></button>
        <button class="carousel-zone carousel-zone-next" type="button" data-carousel-next aria-label="Next slide"></button>
        <div class="card-track" data-card-track>
            <section class="card-panel profile-panel" aria-label="Profile">
                <div class="descripcion">
                    <h1>{name}</h1>
                    <h2>
                        I'm&nbsp;
                        <span
                            class="txt-rotate"
                            data-period="300"
                            data-rotate='["a Senior Software Engineer.", "an API Engineer.", "a Mobile Web Developer.", "a NodeJS Developer.", "a Reactjs Developer.", "a Vuejs Developer."]'
                            aria-live="polite"
                        >{position}.</span>
                    </h2>
                    <p>{aboutMe}</p>
                    <div class="icons">
                        <a href={linkedin} class="hover-text" target="_blank" rel="noopener noreferrer">
                            <span class="tooltip-text">LinkedIn</span>
                            <i class="bi bi-linkedin"></i>
                        </a>
                        <a href={github} class="hover-text" target="_blank" rel="noopener noreferrer">
                            <span class="tooltip-text">GitHub</span>
                            <i class="bi bi-github"></i>
                        </a>
                        <a href={cvLink} class="hover-text" target="_blank" rel="noopener noreferrer">
                            <span class="tooltip-text">Resume</span>
                            <i class="bi bi-file-earmark-arrow-down"></i>
                        </a>
                    </div>
                </div>
                <div class="image">
                    <img src={profileImage} alt={`${name} profile`}>
                </div>
            </section>

            <section class="card-panel education-panel" aria-label="Education">
                <div class="education-content">
                    <p class="eyebrow">Background</p>
                    <h2>Education</h2>
                    <div class="education-list">
                        {education.map((item) => (
                            <article class="education-item">
                                <img src={item.logo} alt={`${item.school} logo`}>
                                <div class="education-details">
                                    <time>{item.period}</time>
                                    <h3>{item.school}</h3>
                                    <p class="company">{item.location}</p>
                                    <p>{item.description}</p>
                                </div>
                            </article>
                        ))}
                    </div>
                </div>
            </section>

            <section class="card-panel experience-panel" aria-label="Work experience">
                <div class="experience-content">
                    <p class="eyebrow">Career</p>
                    <h2>Work experience</h2>
                    <div class="experience-list">
                        {workExperience.map((experience) => (
                            <article class="experience-item">
                                <div>
                                    <h3>{experience.role}</h3>
                                    <p class="company">{experience.company}</p>
                                </div>
                                <time>{experience.period}</time>
                                <p>{experience.description}</p>
                            </article>
                        ))}
                    </div>
                </div>
            </section>

            <section class="card-panel portfolio-panel" aria-label="Portfolio">
                <div class="portfolio-content">
                    <p class="eyebrow">Selected work</p>
                    <h2>Portfolio</h2>
                    <div class="portfolio-list">
                        {portfolio.map((item) => (
                            <article class="portfolio-item" tabindex="0">
                                <img src={item.image} data-gif={item.gif} alt={`${item.title} project preview`}>
                                <div class="portfolio-details">
                                    <h3>{item.title}</h3>
                                    <p>{item.description}</p>
                                </div>
                            </article>
                        ))}
                    </div>
                    <div class="portfolio-lightbox" data-portfolio-lightbox role="dialog" aria-modal="true" aria-labelledby="portfolio-lightbox-title" hidden>
                        <button class="portfolio-lightbox-close" type="button" data-portfolio-close aria-label="Close project preview">&times;</button>
                        <img data-portfolio-lightbox-image alt="">
                        <div>
                            <h3 data-portfolio-lightbox-title></h3>
                            <p data-portfolio-lightbox-description></p>
                        </div>
                    </div>
                </div>
            </section>

            

            <section class="card-panel contact-panel" aria-label="How to reach me">
                <div class="contact-content">
                    <p class="eyebrow">Let's connect</p>
                    <h2>How to reach me</h2>
                    <p class="contact-intro">Have an opportunity or a question? Send me a message at <a href="mailto:jmi050994@gmail.com">jmi050994@gmail.com</a>.</p>
                    <form class="contact-form" data-contact-form>
                        <label>
                            Your name
                            <input name="name" type="text" autocomplete="name" required>
                        </label>
                        <label>
                            Your email
                            <input name="email" type="email" autocomplete="email" required>
                        </label>
                        <label>
                            Message
                            <textarea name="message" rows="4" required></textarea>
                        </label>
                        <button type="submit">Open email</button>
                    </form>
                </div>
            </section>
        </div>
    </div>
</div>

<script>
    const card = document.querySelector<HTMLElement>('[data-card]');
    const track = document.querySelector<HTMLElement>('[data-card-track]');
    let startX = 0;
    let currentX = 0;
    let startY = 0;
    let currentY = 0;
    let isDragging = false;
    let panelIndex = 0;
    const swipeThreshold = 28;

    const setCardState = (nextPanelIndex: number) => {
        panelIndex = Math.max(0, Math.min(5, nextPanelIndex));
        track?.style.setProperty('--panel-index', `${panelIndex}`);
    };

    const previousSlide = document.querySelector<HTMLButtonElement>('[data-carousel-previous]');
    const nextSlide = document.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const navigateFromZone = (direction: number, event: Event) => {
        event.stopPropagation();
        isDragging = false;
        track?.classList.remove('is-dragging');
        track?.style.removeProperty('--drag-offset');
        setCardState(panelIndex + direction);
    };

    previousSlide?.addEventListener('pointerdown', (event) => event.stopPropagation());
    nextSlide?.addEventListener('pointerdown', (event) => event.stopPropagation());
    previousSlide?.addEventListener('click', (event) => navigateFromZone(-1, event));
    nextSlide?.addEventListener('click', (event) => navigateFromZone(1, event));

    card?.addEventListener('pointerdown', (event: PointerEvent) => {
        startX = event.clientX;
        currentX = startX;
        startY = event.clientY;
        currentY = startY;
        isDragging = true;
        card.setPointerCapture(event.pointerId);
        track?.classList.add('is-dragging');
    });

    card?.addEventListener('pointermove', (event: PointerEvent) => {
        if (!isDragging || !track) return;
        currentX = event.clientX;
        currentY = event.clientY;
        const distance = currentX - startX;
        track.style.setProperty('--drag-offset', `${distance}px`);
    });

    const finishSwipe = (event: PointerEvent) => {
        if (!isDragging) return;
        isDragging = false;
        card?.releasePointerCapture(event.pointerId);

        const horizontalDistance = Math.abs(currentX - startX);
        const verticalDistance = Math.abs(currentY - startY);
        const hasSwiped = horizontalDistance > swipeThreshold && horizontalDistance > verticalDistance;
        track?.classList.remove('is-dragging');

        if (hasSwiped && track) {
            setCardState(panelIndex + (currentX < startX ? 1 : -1));
            requestAnimationFrame(() => track.style.removeProperty('--drag-offset'));
        } else {
            track?.style.removeProperty('--drag-offset');
        }
    };

    card?.addEventListener('pointerup', finishSwipe);
    card?.addEventListener('pointercancel', finishSwipe);

    document.querySelectorAll<HTMLImageElement>('[data-gif]').forEach((image) => {
        const preview = image.src;
        const animation = image.dataset.gif;
        if (!animation) return;

        const showAnimation = () => { image.src = animation; };
        const showPreview = () => { image.src = preview; };
        image.closest('.portfolio-item')?.addEventListener('pointerenter', showAnimation);
        image.closest('.portfolio-item')?.addEventListener('pointerleave', showPreview);
        image.closest('.portfolio-item')?.addEventListener('focusin', showAnimation);
        image.closest('.portfolio-item')?.addEventListener('focusout', showPreview);
    });

    const lightbox = document.querySelector<HTMLElement>('[data-portfolio-lightbox]');
    const lightboxImage = document.querySelector<HTMLImageElement>('[data-portfolio-lightbox-image]');
    const lightboxTitle = document.querySelector<HTMLElement>('[data-portfolio-lightbox-title]');
    const lightboxDescription = document.querySelector<HTMLElement>('[data-portfolio-lightbox-description]');
    const closeLightbox = document.querySelector<HTMLButtonElement>('[data-portfolio-close]');

    const hideLightbox = () => {
        if (!lightbox) return;
        lightbox.hidden = true;
        lightboxImage?.removeAttribute('src');
    };

    const showLightbox = (item: HTMLElement) => {
        const image = item.querySelector<HTMLImageElement>('img');
        const title = item.querySelector<HTMLElement>('.portfolio-details h3');
        const description = item.querySelector<HTMLElement>('.portfolio-details p');
        if (!lightbox || !image || !title || !description) return;

        lightboxImage?.setAttribute('src', image.dataset.gif ?? image.src);
        lightboxImage?.setAttribute('alt', image.alt);
        if (lightboxTitle) lightboxTitle.textContent = title.textContent;
        if (lightboxDescription) lightboxDescription.textContent = description.textContent;
        lightbox.hidden = false;
        closeLightbox?.focus();
    };

    document.querySelectorAll<HTMLElement>('.portfolio-item').forEach((item) => {
        item.addEventListener('click', (event) => {
            event.stopPropagation();
            showLightbox(item);
        });
        item.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                showLightbox(item);
            }
        });
    });

    closeLightbox?.addEventListener('click', hideLightbox);
    lightbox?.addEventListener('click', (event) => {
        if (event.target === lightbox) hideLightbox();
    });
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') hideLightbox();
    });

    document.querySelectorAll<HTMLElement>('.txt-rotate').forEach((rotator) => {
        const phrases = JSON.parse(rotator.dataset.rotate ?? '[]') as string[];
        const pause = Number(rotator.dataset.period ?? 300);
        let phraseIndex = 0;
        let characterIndex = rotator.textContent?.length ?? 0;
        let isDeleting = true;

        const typePhrase = () => {
            if (!phrases.length) return;
            const phrase = phrases[phraseIndex];
            characterIndex += isDeleting ? -1 : 1;
            rotator.textContent = phrase.substring(0, characterIndex);

            let delay = isDeleting ? 45 : 85;
            if (!isDeleting && characterIndex === phrase.length) {
                delay = pause;
                isDeleting = true;
            } else if (isDeleting && characterIndex === 0) {
                isDeleting = false;
                phraseIndex = (phraseIndex + 1) % phrases.length;
                delay = 180;
            }

            window.setTimeout(typePhrase, delay);
        };

        window.setTimeout(typePhrase, pause);
    });

    const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
    contactForm?.addEventListener('pointerdown', (event) => event.stopPropagation());
    contactForm?.addEventListener('pointermove', (event) => event.stopPropagation());
    contactForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        const formData = new FormData(contactForm);
        const name = String(formData.get('name') ?? '');
        const email = String(formData.get('email') ?? '');
        const message = String(formData.get('message') ?? '');
        const subject = encodeURIComponent(`Portfolio inquiry from ${name}`);
        const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\n\n${message}`);
        window.location.href = `mailto:jmi050994@gmail.com?subject=${subject}&body=${body}`;
    });
</script>